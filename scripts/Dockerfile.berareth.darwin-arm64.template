# =============================================================================
# Cross-compilation Dockerfile: bera-reth for darwin-arm64 (macOS Apple Silicon)
# =============================================================================
# This Dockerfile builds a native macOS ARM64 binary from source inside Docker.
# Rust cross-compilation to macOS requires cargo-zigbuild, which uses Zig as a
# cross-linker capable of targeting aarch64-apple-darwin without the macOS SDK.
#
# Usage:
#   docker build -f scripts/Dockerfile.berareth.darwin-arm64.template \
#     --build-arg BERA_RETH_TAG=v1.5.0 \
#     -t beranode-builder-bera-reth-darwin-arm64:v1.5.0 .
# =============================================================================

# Use official Rust image (includes rustup for target management)
FROM rust:slim-bookworm

# Build argument for the tag (defaults to "latest" which will fetch the latest release)
ARG BERA_RETH_TAG=latest

# Install build dependencies and cross-compilation toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        wget \
        git \
        bash \
        make \
        pkg-config \
        libclang-dev \
        llvm-dev \
        perl \
        python3 \
        python3-pip \
        xz-utils && \
    pip3 install --break-system-packages ziglang cargo-zigbuild && \
    rustup target add aarch64-apple-darwin && \
    rm -rf /var/lib/apt/lists/*

# Clone, checkout tag, and cross-compile for darwin-arm64
RUN cd /tmp && git clone https://github.com/berachain/bera-reth.git && \
    cd bera-reth && \
    git fetch --tags && \
    if [ "$BERA_RETH_TAG" = "latest" ]; then \
        TAG=$(curl -sI https://github.com/berachain/bera-reth/releases/latest | grep -i location: | grep -oE '/tag/[^ ]+' | awk -F'/tag/' '{print $2}' | tr -d '\r\n'); \
    else \
        TAG="$BERA_RETH_TAG"; \
    fi && \
    git checkout $TAG && \
    cargo zigbuild --release --target aarch64-apple-darwin && \
    cp /tmp/bera-reth/target/aarch64-apple-darwin/release/bera-reth /usr/local/bin/bera-reth && \
    chmod +x /usr/local/bin/bera-reth

# Clean up build artifacts
RUN rm -rf /tmp/* /var/cache/apt/*

# NOTE: Cannot verify binary here — it's a macOS binary inside a Linux container.
# Verification happens on the host after extraction via 'docker cp'.

CMD ["tail", "-f", "/dev/null"]
